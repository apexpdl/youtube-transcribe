# Root environment file consumed by docker-compose.
# Copy to ".env" and adjust as needed:  cp .env.example .env

# The URL the browser uses to reach the backend (baked into the frontend build).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Whisper model size: tiny | base | small | medium | large
WHISPER_MODEL=base

# Optional: enables high-quality AI summaries & translation.
# Leave blank to use the built-in extractive summary.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
