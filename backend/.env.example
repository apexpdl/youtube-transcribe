# ----- General -----
ENVIRONMENT=development
DEBUG=true

# Path prefix when the API is mounted behind a proxy at a sub-path.
# Leave empty for local/Docker. On Vercel multi-service set: ROOT_PATH=/_/backend
ROOT_PATH=

# Comma-separated list of allowed CORS origins (your frontend URL).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ----- Caching -----
CACHE_ENABLED=true
CACHE_DIR=.cache
# How long to keep cached transcripts (seconds). Default: 7 days.
CACHE_TTL_SECONDS=604800

# ----- Temp files -----
TEMP_DIR=.tmp
# Delete downloaded audio after processing.
CLEANUP_FILES=true

# ----- Whisper (local speech-to-text fallback) -----
WHISPER_ENABLED=true
# tiny | base | small | medium | large  (bigger = more accurate but slower)
WHISPER_MODEL=base
# auto | cpu | cuda
WHISPER_DEVICE=auto
# Refuse Whisper on videos longer than this many seconds (protects the server).
MAX_WHISPER_DURATION_SECONDS=3600

# ----- yt-dlp -----
YTDLP_FORMAT=bestaudio/best
# Optional outbound proxy, e.g. http://user:pass@host:port
# YTDLP_PROXY=
# Optional cookies file path to access age-restricted videos.
# YTDLP_COOKIEFILE=

# ----- Rate limiting -----
RATE_LIMIT_ENABLED=true
RATE_LIMIT=30/minute
RATE_LIMIT_TRANSCRIPT=10/minute

# ----- Jobs -----
JOB_TTL_SECONDS=3600
MAX_CONCURRENT_JOBS=2

# ----- OpenAI (optional: enables high-quality AI summary + translation) -----
# Leave blank to use the built-in extractive summary fallback.
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
SUMMARY_ENABLED=true
